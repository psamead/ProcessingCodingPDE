{
  "name": "processing-pde-support",
  "displayName": "Processing PDE Support",
  "description": "Lightweight Processing 3.5.4 PDE language support for VS Code.",
  "version": "0.0.2",
  "publisher": "psamead",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/psamead/processing-pde-support.git"
  },
  "icon": "pde-128.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "processing",
    "processing 3",
    "processing 3.5.4",
    "pde",
    "java",
    "creative coding",
    "snippets",
    "intellisense"
  ],
  "activationEvents": [
    "onLanguage:pde",
    "onCommand:processing35.runSketch",
    "onCommand:processing35.openReference"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "processing35.runSketch",
        "title": "Processing 3.5.4: Run Sketch",
        "icon": {
          "light": "./run-pressed-1x.png",
          "dark": "./run-pressed-1x.png"
        }
      },
      {
        "command": "processing35.openReference",
        "title": "Processing 3.5.4: Open Reference for Selection"
      }
    ],
    "languages": [
      {
        "id": "pde",
        "aliases": [
          "Processing",
          "PDE"
        ],
        "extensions": [
          ".pde"
        ],
        "configuration": "./language/pde.language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "pde",
        "scopeName": "source.pde",
        "path": "./syntaxes/pde.tmLanguage"
      }
    ],
    "snippets": [
      {
        "language": "pde",
        "path": "./snippets/processing-35.code-snippets"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "editorLangId == pde",
          "command": "processing35.runSketch",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "when": "editorLangId == pde",
          "command": "processing35.openReference",
          "group": "navigation@1"
        },
        {
          "when": "editorLangId == pde",
          "command": "processing35.runSketch",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Processing 3.5.4",
      "properties": {
        "processing35.path": {
          "type": "string",
          "default": "processing-java",
          "description": "Path to Processing 3.5.4 processing-java or to a wrapper script that launches it."
        },
        "processing35.outputFolder": {
          "type": "string",
          "default": "out",
          "description": "Sketch output folder name used by the Processing 3.5.4 run command."
        },
        "processing35.cleanWindowsPath": {
          "type": "boolean",
          "default": true,
          "description": "On Windows, launch absolute processing-java.exe paths with a minimal PATH to avoid the Processing 3.5.4 'main class Files' launcher bug."
        },
        "processing35.referenceBaseUrl": {
          "type": "string",
          "default": "https://processing.org/reference/",
          "description": "Base URL used when opening Processing reference pages."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test",
    "package": "npx @vscode/vsce package"
  },
  "devDependencies": {
    "@types/vscode": "1.70.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "eslint": "^9.39.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
